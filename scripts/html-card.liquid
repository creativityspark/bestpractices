<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ rule.id }} - {{ rule.title }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #ffffff;
            margin: 0;
            padding: 0;
        }

        .card {
            width: 100%;
            background: #ffffff;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Header */
        .card-header {
            background: #1b2a4a;
            padding: 24px 32px;
        }

        .card-header .header-title {
            font-size: 14px;
            font-weight: 600;
            color: #b0c4de;
            margin-bottom: 2px;
        }

        .card-header .header-subtitle {
            font-size: 12px;
            color: #8fa4c8;
            margin-bottom: 16px;
        }

        .card-header .title-row {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .card-header .title-row a {
            text-decoration: none;
        }

        .card-header .rule-id {
            background: #0078d4;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 4px;
            white-space: nowrap;
        }

        .card-header .rule-title {
            font-size: 26px;
            font-weight: 700;
            color: #ffffff;
        }

        /* Footer */
        .card-footer {
            padding: 16px 32px;
            text-align: center;
            font-size: 12px;
            color: #888;
            border-top: 1px solid #e0e0e0;
            margin-top: auto;
        }

        .card-footer a {
            color: #0078d4;
            text-decoration: none;
            font-weight: 600;
        }

        .card-footer a:hover {
            text-decoration: underline;
        }

        /* Body */
        .card-body {
            padding: 32px;
        }

        /* Navigation buttons */
        .nav-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 4px;
            margin-bottom: 12px;
        }

        .nav-buttons a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 4px;
            border: 1px solid #e0e0e0;
            color: #555;
            text-decoration: none;
            transition: background 0.15s, border-color 0.15s;
        }

        .nav-buttons a:hover {
            background: #f0f0f0;
            border-color: #0078d4;
            color: #0078d4;
        }

        .nav-buttons a.disabled {
            opacity: 0.3;
            pointer-events: none;
        }

        /* The Rule */
        .rule-statement {
            border-left: 4px solid #0078d4;
            padding: 16px 20px;
            margin-bottom: 32px;
            background: #f8fafc;
        }

        .rule-statement p {
            font-size: 15px;
            font-weight: 600;
            font-style: italic;
            color: #1b2a4a;
            line-height: 1.5;
        }

        /* Rationale grid */
        .rationale-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .rationale-grid .step-card {
            background: #f8fafc;
            border-color: #27ae60;
        }

        /* How to Apply grid */
        .steps-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 32px;
        }

        .step-card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 20px;
        }

        .step-card .step-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 0;
        }

        .step-card .step-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border-radius: 50%;
            background: #edf4fc;
            border: 1px solid #d9e8f8;
        }

        .step-card .step-icon img {
            width: 18px;
            height: 18px;
        }

        .step-card .step-description {
            font-size: 14px;
            color: #555;
            line-height: 1.5;
        }

        .step-card .step-description p:first-child {
            margin-top: 0;
        }

        .step-card .step-description p:last-child {
            margin-bottom: 0;
        }

        /* Examples section */
        .examples-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 16px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .example-box {
            border-radius: 8px;
            padding: 20px;
            border: 2px solid;
        }

        .example-box.do {
            border-color: #27ae60;
            background: #f0faf4;
        }

        .example-box.dont {
            border-color: #c0392b;
            background: #fdf4f3;
        }

        .example-box .example-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .example-box .example-kind {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .example-box .example-kind-icon {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .example-box .example-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .example-box.do .example-label {
            color: #27ae60;
        }

        .example-box.dont .example-label {
            color: #c0392b;
        }

        .example-content {
            font-size: 13px;
            color: #333;
            line-height: 1.55;
        }

        .example-content p:first-child {
            margin-top: 0;
        }

        .example-content p:last-child {
            margin-bottom: 0;
        }

        .example-prose-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .example-prose-row .example-prose-icon {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .example-content pre {
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 12px;
            white-space: pre-wrap;
            word-break: break-word;
            background: #ffffff;
            border: 1px solid #d8dee8;
            border-radius: 6px;
            padding: 10px;
            color: #1f2a44;
        }

        .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #1b2a4a;
            margin-bottom: 12px;
        }

        .info-card {
            margin-top: 24px;
            background: #f8fafc;
            border-left: 4px solid #0078d4;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .section-header-icon {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        .references-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .references-list li {
            margin-bottom: 6px;
            font-size: 13px;
            line-height: 1.5;
        }

        @media (max-width: 768px) {
            .card-body {
                padding: 20px;
            }

            .steps-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="card">
        <!-- Header -->
        <div class="card-header">
            <div class="header-title">Power Platform Best Practices</div>
            <div class="header-subtitle">{{ breadcrumb_topic }} / {{ breadcrumb_sub_topic }}</div>
            <div class="title-row">
                <a href="#"><span class="rule-id">{{ rule.id }}</span></a>
                <a href="#"><span class="rule-title">{{ rule.title }}</span></a>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body">
            <!-- Navigation -->
            <div class="nav-buttons">
                <a href="{{ prev_url }}" title="Go to the previous rule" class="{{ prev_disabled }}"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18l-6-6l6-6"/></svg></a>
                <a href="{{ index_url }}" title="Go to index"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9.5L12 4l9 5.5M5 10v9h14v-9M9 19v-5h6v5"/></svg></a>
                <a href="{{ next_url }}" title="Go to the next rule" class="{{ next_disabled }}"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18l6-6l-6-6"/></svg></a>
            </div>

            <!-- The Rule -->
            <div class="rule-statement">
                {{ rule.description_html | raw }}
            </div>

            <!-- How to Apply -->
            <div class="steps-grid">
                {% for guideline in rule.guidelines %}
                <div class="step-card">
                    <div class="step-header">
                        <div class="step-icon">
                            <img src="{{ asset_img_prefix }}/{% if guideline.icon %}{{ guideline.icon }}{% else %}icons/lightbulb.svg{% endif %}" alt="Guideline icon" />
                        </div>
                        <div class="step-description">{{ guideline.text_html | raw }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- Rationale -->
            <div class="rationale-grid">
                {% for rationale in rule.rationale %}
                <div class="step-card">
                    <div class="step-header">
                        <div class="step-icon">
                            <img src="{{ asset_img_prefix }}/{% if rationale.icon %}{{ rationale.icon }}{% else %}icons/info.svg{% endif %}" alt="Rationale icon" />
                        </div>
                        <div class="step-description">{{ rationale.text_html | raw }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- Examples -->
            <div class="section-title">Examples</div>
            <div class="examples-grid">
                {% for example in rule.examples.good %}
                <div class="example-box do">
                    <div class="example-header">
                        <div class="example-kind">
                            <img class="example-kind-icon" src="{{ asset_img_prefix }}/icons/circle-check-big.svg" alt="Good example" />
                            <span class="example-label">Do</span>
                        </div>
                    </div>
                    <div class="example-content">
                        {% if example.code %}
                        <pre>{{ example.code }}</pre>
                        {% else %}
                        <div class="example-prose-row">
                            <img class="example-prose-icon" src="{{ asset_img_prefix }}/{% if example.icon %}{{ example.icon }}{% else %}icons/file-text.svg{% endif %}" alt="Example icon" />
                        </div>
                        <div>{{ example.text_html | raw }}</div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}

                {% for example in rule.examples.bad %}
                <div class="example-box dont">
                    <div class="example-header">
                        <div class="example-kind">
                            <img class="example-kind-icon" src="{{ asset_img_prefix }}/icons/x.svg" alt="Bad example" />
                            <span class="example-label">Don't</span>
                        </div>
                    </div>
                    <div class="example-content">
                        {% if example.code %}
                        <pre>{{ example.code }}</pre>
                        {% else %}
                        <div class="example-prose-row">
                            <img class="example-prose-icon" src="{{ asset_img_prefix }}/{% if example.icon %}{{ example.icon }}{% else %}icons/circle-alert.svg{% endif %}" alt="Example icon" />
                        </div>
                        <div>{{ example.text_html | raw }}</div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>

            {% if rule.pattern %}
            <div class="rule-statement" style="margin-top: 24px;">
                <p><strong>Pattern:</strong> {{ rule.pattern }}</p>
            </div>
            {% endif %}

            {% if rule.references and rule.references.size > 0 %}
            <div class="step-card info-card">
                <div class="section-header">
                    <img class="section-header-icon" src="{{ asset_img_prefix }}/icons/info.svg" alt="More information" />
                    <div class="section-title" style="margin-bottom: 0;">More Information</div>
                </div>
                <div class="step-description">
                    <ul class="references-list">
                        {% for reference in rule.references %}
                        <li><a href="{{ reference.url }}" target="_blank" rel="noopener noreferrer">{{ reference.title }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Footer -->
        <div class="card-footer">
            Created with ❤️ by <a href="https://creativityspark.es">Creativity Spark</a>
        </div>
    </div>
</body>
</html>
